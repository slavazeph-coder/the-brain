# World Builder worker environment — copy to .env (or export in the worker
# shell) and fill real values. The worker (robotics/world_worker/app.py)
# refuses to start when required values are missing or invalid.
#
# Never commit real values: keep the live .env outside the repository or in
# .gitignore, and never reuse an authentication or ticket credential as the
# report signing key.

# --- Required: worker authentication -------------------------------------
# Random secret, at least 32 characters. The worker fails startup if it is
# unset or shorter than 32 characters. Every job request must carry this
# token; it is the worker's only request authentication.
WORLD_WORKER_TOKEN=

# --- Worker storage / configuration ---------------------------------------
# Where the worker keeps job state and artifacts. Default: ./world-worker-data
WORLD_WORKER_DIR=

# JSON file listing the enabled reconstruction engines/adapters. Unset means
# only the built-in engine set is configured.
WORLD_ADAPTERS_FILE=

# JSON file defining tenant (owner) identities and admission limits. Unset
# means private-owner defaults.
WORLD_TENANTS_FILE=

# --- Signed report receipts (optional) ------------------------------------
# Absolute path to a 32-byte Ed25519 private key, mode 0600, regular file,
# and OUTSIDE WORLD_WORKER_DIR. Signing is disabled (503 on /v1/report-key)
# until all of these hold; a configured worker fails startup when the key,
# permissions, or location are invalid. Generate once with:
#   python -m robotics.world_worker.report_receipts init-key \
#     --private-key <this path> --public-key <this path>.pub
# Requires robotics/world_worker/requirements-report-receipts.txt (pinned
# cryptography). See docs/world-studio-implementation.md §Report receipts.
WORLD_REPORT_SIGNING_KEY=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the worker API.
WORLD_ALLOWED_ORIGINS=https://www.brainsnn.com,https://brainsnn.com,http://127.0.0.1:8765,http://localhost:8765

# --- GPU / reconstruction engine env (forwarded into engine processes) -----
# MapAnything source checkout and model weights directory.
WORLD_MAPANYTHING_SOURCE_DIR=
WORLD_MAPANYTHING_MODEL_DIR=
# Depth estimation model directory.
WORLD_DEPTH_MODEL_DIR=

# --- Video-language observation adapter (optional) -------------------------
# Enables the VLM observation adapter when set to 1/true; empty disables it.
WORLD_VLM_ENABLED=
WORLD_VLM_BASE_URL=
WORLD_VLM_MODEL=
WORLD_VLM_REVISION=
WORLD_VLM_API_KEY=

# --- Test/smoke harness env (tests only; not used by the serving worker) ---
# Browsers and python executables for the Playwright/browser smoke tests:
#   WORLD_BROWSERS, WORLD_SERVER_PYTHON, WORLD_REPORT_PYTHON,
#   WORLD_OBSERVATIONS_PYTHON, WORLD_COLMAP_PYTHON,
#   WORLD_COLMAP_TEST_CAPTURE, WORLD_URL, WORLD_SITE_URL, WORLD_PHOTO
# Set these in the test runner environment, not in the serving .env.
