# Generate independently: python -c 'import secrets; print(secrets.token_urlsafe(48))'
BRAIN_SITE_TOKEN=
BRAIN_SITE_ORIGINS=https://www.brainsnn.com,https://brainsnn.com
BRAIN_SITE_DATA=/var/lib/brainsnn/site-scans
# Enable only after installing and validating FFmpeg, FFprobe and COLMAP locally.
BRAIN_SITE_ENABLED=0
BRAIN_SITE_COLMAP=colmap
BRAIN_SITE_FFMPEG=ffmpeg
BRAIN_SITE_FFPROBE=ffprobe
# Operator attestation of the installed COLMAP source revision, exactly 40 hex characters.
BRAIN_SITE_COLMAP_REVISION=
# Optional visual reconstruction. Empty means sparse COLMAP only.
BRAIN_SITE_VISUAL_ADAPTER=
BRAIN_SITE_VISUAL_ADAPTER_SHA256=
BRAIN_SITE_3DGRUT_ROOT=
BRAIN_SITE_3DGRUT_PYTHON=
BRAIN_SITE_3DGRUT_REVISION=e6f4552b408af020a96de09ab5757f9b57430aaa
