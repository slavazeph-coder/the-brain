# Generate a unique secret, do not put a production token in this file or git.
ARENA_TOKEN=
ARENA_ALLOWED_ORIGINS=https://www.brainsnn.com,https://brainsnn.com
# Connect only to an operator-owned verified OpenPI server, through private networking.
ARENA_POLICY_URL=ws://127.0.0.1:8010
# Output of checkpoint_manifest.py; verified against model-server metadata.
ARENA_CHECKPOINT_REVISION=
ARENA_SESSION_TTL=900
ARENA_IDLE_TTL=120
# Optional distinct read-only secret. It can read archives/capabilities, never command a session.
ARENA_READ_TOKEN=
# Mount this path on persistent storage in containers. Recordings outlive session/idle TTL.
ARENA_RECORDING_DIR=~/.local/share/brainsnn-arena/recordings
ARENA_RECORDING_QUEUE_SIZE=64
ARENA_RECORDING_MAX_BYTES=67108864
ARENA_RECORDING_MAX_COUNT=50
ARENA_RECORDING_TOTAL_BYTES=1073741824
ARENA_RECORDING_RETENTION_SECONDS=604800
# Bounded flush after finalization; forced termination recovers an unknown tail.
ARENA_RECORDING_SHUTDOWN_TIMEOUT=5
