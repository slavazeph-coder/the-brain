# Generate a random token locally. Never commit or place it in a public VITE_ variable.
WORLD_WORKER_TOKEN=
WORLD_WORKER_DIR=/data/world-worker
WORLD_ALLOWED_ORIGINS=https://www.brainsnn.com,https://brainsnn.com
# Optional, private operator-provisioned identities. Absolute path to a JSON
# registry with schema brainsnn.world.tenants.v1 (see public/world/api.html).
# Stores SHA-256 hashes of random >=32-byte URL-safe tokens, never raw tokens.
# Default grant: inspect only; no signup or billing authority. Replace atomically.
# WORLD_TENANTS_FILE=/operator/world-tenants.json
# Existing uploads/jobs always remain owned by reserved identity "operator".
# Tenant tokens must never equal WORLD_WORKER_TOKEN or appear in VITE_ variables.
# Leave unset until absolute executable paths and model rights are reviewed.
# WORLD_ADAPTERS_FILE=/operator/adapters.json
# WORLD_DEPTH_MODEL_DIR=/models/pinned-depth-anything-v2-small-snapshot
