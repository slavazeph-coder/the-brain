# /etc/brainsnn/world-worker.env (mode 600, owned by root). Never commit the real file.
# Generate the token with: python3 -c "import secrets; print(secrets.token_hex(32))"
WORLD_WORKER_TOKEN=replace-with-at-least-32-random-characters
WORLD_WORKER_DIR=/var/lib/brainsnn-world-worker
WORLD_ADAPTERS_FILE=/etc/brainsnn/adapters.json
# Only the site. Wildcards are refused.
WORLD_ALLOWED_ORIGINS=https://www.brainsnn.com,https://brainsnn.com
# Adapters (Blender, model caches) write under HOME; keep it inside the writable state directory.
HOME=/var/lib/brainsnn-world-worker
# Add adapter settings here, e.g. CUDA_VISIBLE_DEVICES, HF_HOME, WORLD_MAPANYTHING_MODEL_DIR,
# WORLD_LINGBOT_SOURCE_DIR, WORLD_LINGBOT_MODEL_PATH (docs/hermes-gpu-tasks.md section 6).
# Object naming (optional): Claude names separated objects when a person approves it for a scene job. The key reaches only
# adapters that list it under "secrets" in adapters.json; leave it unset and the site does not offer naming.
# ANTHROPIC_API_KEY=
