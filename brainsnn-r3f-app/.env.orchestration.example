# Optional private operations. Disabled by default. See ops/gpu/orchestration-runbook.md.
ORCHESTRATION_ENABLED=0
# Explicitly assert one app replica and attach a persistent LOCAL volume first.
ORCHESTRATION_SINGLE_REPLICA=0
ORCHESTRATION_DB_PATH=
# Distinct generated owner and worker credentials, each 32..256 characters.
ORCHESTRATION_OWNER_KEY=
ORCHESTRATION_WORKER_KEY=
# Must exactly match the existing runtime's SERVED_MODEL_NAME.
GPU_INFERENCE_MODEL=
