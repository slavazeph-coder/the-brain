{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node scripts/build-meshlets.mjs && tsx server.ts",
    "build": "node scripts/build-project-hash.mjs && node scripts/build-arena-pricing.mjs && node scripts/build-site-renderer.mjs && node scripts/build-twin-renderer.mjs && node scripts/build-street-renderer.mjs && node scripts/build-deformable.mjs && node scripts/build-fragments-export.mjs && node scripts/build-movement-pose.mjs && node scripts/build-meshlets.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node mission-market-schema-bootstrap.cjs && node --require ./sponsorship/gt3/server.cjs --require ./brand-brain-preload.cjs --require ./mission-market-preload.cjs --require ./sponsorship/server.cjs dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --check brand-brain-preload.cjs && node --check mission-market-preload.cjs && node --check mission-market-schema-bootstrap.cjs && node scripts/check-three-imports.mjs && node --experimental-strip-types --no-warnings scripts/test-runner.mjs && npm run test:analysis",
    "test:run": "node --experimental-strip-types --no-warnings scripts/test-runner.mjs",
    "check:bundle": "node scripts/check-three-imports.mjs",
    "test:e2e": "playwright test",
    "og:toys": "node scripts/render-toy-og.mjs",
    "test:analysis": "node --test arena-analysis/tests/*.test.cjs",
    "analysis:admin": "node arena-analysis/admin.cjs",
    "test:world": "node --test ../tests/world/*.test.mjs src/world/street/tests/*.test.mjs",
    "world:propose": "node scripts/world-propose-map.mjs",
    "predev": "node scripts/build-deformable.mjs --engine-only && node scripts/build-project-hash.mjs && node scripts/build-twin-renderer.mjs && node scripts/build-movement-pose.mjs",
    "test:world-projects": "node --test ../tests/world/*project*.test.mjs",
    "world:projects:admin": "node scripts/world-project-admin.mjs",
    "world:projects:worker": "node scripts/world-project-worker-tenant.mjs",
    "world:projects:storage": "node scripts/world-project-storage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@google/genai": "^2.4.0",
    "@mujoco/mujoco": "4.0.1",
    "@noble/hashes": "2.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@thatopen/fragments": "3.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "22.6.0",
    "three": "^0.182.0",
    "three-meshlets": "npm:three@0.187.0",
    "vite": "^6.2.3",
    "web-ifc": "0.0.79"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
