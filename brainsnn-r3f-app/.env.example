# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Dedicated GPU: server-only OpenAI-compatible API base, including /v1.
# Requires all three values. HTTPS is required except for a loopback SSH tunnel.
# Never prefix these with VITE_. Keep the token in Railway service variables.
# When configured, /api/analyze prefers this GPU and falls back to the local
# engine on failure or saturation. /api/engine/compare remains deterministic.
GPU_INFERENCE_URL=""
GPU_INFERENCE_KEY=""
GPU_INFERENCE_MODEL=""
# Total deadline across connection and response body; clamped to 1000..30000 ms.
# No retries; at most two in-flight analyses per Railway process, no queue.
GPU_INFERENCE_TIMEOUT_MS="15000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LEADS_WEBHOOK_URL: Where POST /api/leads delivers a pilot brief (any endpoint
# that accepts a JSON POST — an automation hook, a sheet, a CRM).
# Unset, /api/leads returns 501 and the form shows its mailto fallback rather
# than claiming a lead was captured.
LEADS_WEBHOOK_URL=""
# Optional bearer token sent with the lead payload.
LEADS_WEBHOOK_TOKEN=""
# Address offered to the visitor whenever a lead could not be delivered.
LEADS_FALLBACK_EMAIL="hello@brainsnn.com"

# VITE_ANALYTICS_URL: Collector that receives track() events as JSON.
# Unset, no events are sent anywhere.
VITE_ANALYTICS_URL=""

# Neural Mirror defaults to the deterministic CPU baseline. All settings below
# are optional; the app starts and scans without weights, a worker, or TRIBE.
NEURAL_MODEL_MODE="cpu"
NEURAL_MODEL_PATH=""
NEURAL_REFERENCE_SPACE="parcel"
NEURAL_PARCEL_COUNT="1000"
NEURAL_WORKER_URL=""
NEURAL_WORKER_TOKEN=""
NEURAL_WORKER_TIMEOUT_MS="30000"
# Materialized JSON index written by the separate neural-mirror research tools.
NEURAL_EXPERIMENTS_PATH=""

# TRIBE v2 is CC BY-NC and is a research reference only. Both the URL and this
# explicit flag are required for its manual research endpoints. It is never in
# the automatic commercial compute route.
TRIBE_API_URL=""
ENABLE_TRIBE_RESEARCH="false"

# Existing decoded-communication transcript gateway (separate from Neural
# Mirror stimulus-response prediction).
NEURAL_DECODER_URL=""
NEURAL_DECODER_KEY=""
