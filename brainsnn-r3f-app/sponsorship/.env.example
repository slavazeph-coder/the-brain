# No real credentials belong in this file or in a browser bundle.
SPONSOR_DB_PATH=/data/brainsnn-sponsor.sqlite
SPONSOR_PUBLIC_ORIGIN=https://www.brainsnn.com
# Generate unique random secrets, each at least 32 bytes, in your secret manager.
SPONSOR_ADMIN_KEY=
SPONSOR_SESSION_SECRET=
# Configure a restricted Stripe key on the server only.
SPONSOR_STRIPE_SECRET_KEY=
SPONSOR_STRIPE_WEBHOOK_SECRET=
# Keep disabled until the restricted key, signed webhook and active tax registration are verified.
SPONSOR_PAYMENTS_ENABLED=false
SPONSOR_TAX_READY=false
