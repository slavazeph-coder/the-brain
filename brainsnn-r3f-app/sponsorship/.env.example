# No real credentials belong in this file or in a browser bundle.
SPONSOR_DB_PATH=/data/brainsnn-sponsor.sqlite
SPONSOR_PUBLIC_ORIGIN=https://www.brainsnn.com
SPONSOR_ALLOWED_ORIGINS=https://www.xioai.ca,https://xioai.ca
# Generate unique random secrets, each at least 32 bytes, in your secret manager.
SPONSOR_ADMIN_KEY=
SPONSOR_SESSION_SECRET=
# Server-only restricted key with Checkout Sessions write permission.
# Validate the actual Checkout request in a sandbox before enabling live payments.
SPONSOR_STRIPE_SECRET_KEY=
# The webhook signing secret can be configured before the API key. Local signed
# event verification remains available while payment creation is disabled.
SPONSOR_STRIPE_WEBHOOK_SECRET=
# Keep disabled until the restricted key, signed webhook and active tax registration are verified.
SPONSOR_PAYMENTS_ENABLED=false
SPONSOR_TAX_READY=false
# Leave empty until actual campaign terms and operational confirmations are ready.
# See README.md for the required schema. This is not supplied by connecting Stripe.
SPONSOR_DIRECT_CAMPAIGN_JSON=
