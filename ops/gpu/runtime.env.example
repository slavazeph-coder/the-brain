# Parsed as literal KEY=VALUE; NOT sourced by a shell. No variable expansion.
# install.py replaces __RUNTIME_DIR__ and creates API keys in this private file.
RUNTIME_DIR=__RUNTIME_DIR__
GPU_API_KEY=GENERATE_ON_INSTALL
BACKEND_API_KEY=GENERATE_ON_INSTALL
BACKGROUND_API_KEY=GENERATE_ON_INSTALL
GATEWAY_PORT=8787
BACKEND_PORT=8000
# Set an absolute executable command as a JSON array. Empty is deliberately idle.
# The included vLLM launcher uses a separately installed, pinned vLLM environment.
INFERENCE_COMMAND=[]
VLLM_EXECUTABLE=/workspace/slava/vllm-venv/bin/vllm
VLLM_DTYPE=bfloat16
VLLM_MAX_NUM_SEQS=1
# Empty means MAX_MODEL_LEN; never smaller than the per-request context limit.
VLLM_MAX_BATCHED_TOKENS=
# Optional parent-prepared complete SHA256 manifest for a local safetensors snapshot.
MODEL_MANIFEST=
CHAT_TEMPLATE_PATH=
CHAT_TEMPLATE_SHA256=
# VLLM_LD_LIBRARY_PATH is optional: explicitly empty clears inherited library paths
# for vLLM only; otherwise use verified existing driver-library directories.
# Alternative local GGUF backend: set INFERENCE_COMMAND to llamacpp_launch.py.
LLAMACPP_EXECUTABLE=
MODEL_SHA256=
GPU_LAYERS=99
BACKEND_PARALLEL=2
# Leave unset for BrainSNN: global grammar conflicts with response_format=json_object.
INFERENCE_JSON_SCHEMA_FILE=
MODEL_PATH=
# Full immutable model commit, or a verified local snapshot digest for evaluation identity.
MODEL_REVISION=
SERVED_MODEL_NAME=brainsnn-local
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.60
# Download only after choosing model + immutable revision and checking free disk.
ALLOW_MODEL_DOWNLOAD=0
# An OPTIONAL finite, useful, resumable training/evaluation command, not a burn loop.
BACKGROUND_COMMAND=[]
BACKGROUND_LABEL=
BACKGROUND_MIN_FREE_MB=7000
BACKGROUND_IDLE_SECONDS=60
BACKGROUND_MAX_START_GPU_PERCENT=20
BACKGROUND_CHECKPOINT_GRACE_SECONDS=2
# Backend process crashes/hangs restart with capped backoff and health checks.
STARTUP_GRACE_SECONDS=900
HEALTH_FAILURE_LIMIT=3
RESTART_MIN_SECONDS=2
RESTART_MAX_SECONDS=60
POLL_SECONDS=5
INFERENCE_TIMEOUT_SECONDS=12
INFERENCE_CONCURRENCY=2
MAX_REQUEST_BYTES=65536
MAX_RESPONSE_BYTES=262144
MAX_OUTPUT_TOKENS=2048
# Optional persistent outbound worker, supervised separately from finite evaluations.
BRIDGE_COMMAND=[]
GPU_BRIDGE_URL=
GPU_BRIDGE_WORKER_KEY=
MIN_DISK_FREE_MB=5120
MAX_CHECKPOINT_MB=16384
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3
# Optional finite backup command. Receives BRAINSNN_CHECKPOINT_DIR, not API keys.
# Must copy atomically completed checkpoints to an independently durable target.
BACKUP_COMMAND=[]
BACKUP_INTERVAL_SECONDS=3600
BACKUP_TIMEOUT_SECONDS=300

# Opt in only after coordinated cutover; never run beside existing bridge/background/renderers.
ORCHESTRATION_ENABLED=0
ORCHESTRATION_URL=
ORCHESTRATION_WORKER_KEY=
ORCHESTRATION_WORKER_ID=
# Controlled local integration tests only; HTTPS remains mandatory otherwise.
ORCHESTRATION_ALLOW_LOOPBACK_HTTP=0
# Retain a healthy idle model between successful leases; render leases drain it first.
ORCHESTRATION_WARM_IDLE_SECONDS=300
COMFY_GPU_COMMAND=[]
COMFY_CPU_COMMAND=[]
COMFY_GPU_PORT=8190
COMFY_CPU_PORT=8189
COMFY_WORKFLOW_MANIFEST=
COMFY_STAGE_TIMEOUT_SECONDS=3600
COMFY_MAX_ARTIFACT_BYTES=268435456
# Separate pinned interpreters, never the vLLM environment.
# Swarms is optional; missing interpreter fails hybrid jobs closed.
SWARMS_PYTHON=
CREWAI_PYTHON=

# Required for orchestration physical ownership; blank defaults fail closed.
# Human attestation of dedicated full-GPU allocation to this container, all
# legacy/orphan GPU users stopped, and competing launchers/monitors disabled.
# See orchestration-runbook.md. Telemetry/PID silence is NOT this attestation.
GPU_OWNERSHIP_SCOPE=
GPU_OWNERSHIP_UUID=
GPU_OWNERSHIP_BASIS=
